{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniseed.org/providers/vercel/configuration-v1.json",
  "title": "Vercel Provider process configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "teamId": { "type": "string", "minLength": 1 },
    "statusProjectId": { "type": "string", "minLength": 1 },
    "desiredRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runtimeAuthTokenEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
    "rotateSecretReferences": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "uniqueItems": true
    },
    "secretReferenceEnvironment": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }
    }
  }
}
